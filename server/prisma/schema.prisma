generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
}

enum Role {
  ADMIN
  STUDENT
}

model Course {
  id              Int       @id @default(autoincrement())
  title           String
  description     String
  price           Decimal   @db.Decimal(10, 2)
  thumbnailUrl    String
  instructorName  String?
  duration        String?
  discountPercent Int?
  lectures        Lecture[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Lecture {
  id          Int      @id @default(autoincrement())
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  videoUrl    String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([courseId, position])
}

model Certificate {
  id            Int      @id @default(autoincrement())
  certCode      String   @unique
  title         String
  issuer        String
  instructor    String
  issueDate     String
  grade         String
  skills        String[]
  verified      Boolean  @default(true)
  credentialUrl String?
  createdAt     DateTime @default(now())
}

model LearningProgress {
  id                Int      @id @default(autoincrement())
  courseId          Int?
  title             String
  instructor        String
  completedLectures Int
  totalLectures     Int
  percent           Int
  status            String
  lastWatched       String
  timeSpent         String
  createdAt         DateTime @default(now())
}

model Discussion {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  author      String
  avatar      String
  replies     Int      @default(0)
  upvotes     Int      @default(0)
  time        String
  badge       String?
  courseLink  String?
  courseTitle String?
  createdAt   DateTime @default(now())
}

model Quiz {
  id         Int      @id @default(autoincrement())
  title      String
  course     String
  courseId   Int?
  questions  Int
  duration   String
  difficulty String
  passScore  String
  status     String
  bestScore  String?
  createdAt  DateTime @default(now())
}
